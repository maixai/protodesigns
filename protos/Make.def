# 共享 make 目标:供各产品原型子目录的 Makefile include 后复用。
# make 在子目录内执行时 cwd 即子目录,故 run / build 直接调用 pnpm 脚本(脚本与子目录 package.json 对应)。

# 可覆盖变量:并行开发多个原型时可传 make run PORT=5174 或设置环境变量覆盖默认值;
# HOST 默认 0.0.0.0(监听所有网卡,允许远程访问),仅本机访问可覆盖为 localhost
PNPM ?= pnpm
PORT ?= 5173
HOST ?= 0.0.0.0
export PNPM

# PORT 必须导出:playwright.config.ts 从 process.env.PORT 推导 BASE_URL,
# 只写成 make 变量时子进程读不到,会静默退回 5173 去测别的实例。
export PORT
BASE_URL ?= http://127.0.0.1:$(PORT)
export BASE_URL

.PHONY: deps run build typecheck contracts contracts-schema contracts-ts contracts-dart contracts-clean smoke smoke-full calibrate calibrate-update quick-check quick-component quick-all storybook storybook-build storybook-test

# Playwright 选测参数:空值展开为空,不污染命令。
PLAYWRIGHT_GREP = $(if $(strip $(GREP)),--grep "$(GREP)",)
PLAYWRIGHT_LAST_FAILED = $(if $(filter 1 true yes,$(LAST_FAILED)),--last-failed,)
PLAYWRIGHT_MAX_FAILURES = $(if $(strip $(MAX_FAILURES)),--max-failures=$(MAX_FAILURES),)
# 指定 tests/quick 的 spec 时补上 quick project;其它情况仍只用 smoke + chromium。
SMOKE_PROJECTS = --project=smoke --project=chromium $(if $(findstring tests/quick,$(SPECS)),--project=quick,)

# ---- 依赖安装 ----
# 新克隆的目录先跑一次 make deps:node_modules 是契约工具链与构建的共同前置。
deps:
	$(PNPM) install

# 启动 dev server(--host / --port 会被 pnpm 原样转发给 vite dev 脚本);
# 先跑契约生成,保证类型与契约一致(生成物不入库,新克隆的目录依赖此步)。
run: contracts
	$(PNPM) dev --host $(HOST) --port $(PORT)

# 构建产物(先跑契约生成,否则 vue-tsc 找不到生成类型)。
build: contracts
	$(PNPM) build

# 仅类型检查:开发回路内的快检用它,比完整 build 少了打包环节。
typecheck: contracts
	$(PNPM) exec vue-tsc --noEmit

# ---- 契约生成(机制层,不含任何"本原型是哪个端"的判断)----
# 输入:contracts/*.tsp —— 数据模型的单一事实源,手写
# 中间:contracts/generated/ —— OpenAPI 与 JSON Schema,生成物勿手改
# 产物:src/contracts/generated/ —— 各端类型,生成物勿手改
#
# 语言相关的步骤按需组合:web / 桌面原型走默认的 schema + ts;
# 其他载体(如 Flutter)在自己的 Makefile 里覆盖 CONTRACTS_DEPS 追加 contracts-dart。
CONTRACTS_SRC    ?= contracts
CONTRACTS_TMP    ?= $(CONTRACTS_SRC)/generated
CONTRACTS_TS_OUT ?= src/contracts/generated
CONTRACTS_DEPS   ?= contracts-schema contracts-ts

# 契约生成入口。
contracts: $(CONTRACTS_DEPS)

# 编译 TypeSpec 契约,产出中间产物(OpenAPI / JSON Schema);
# 用哪些 emitter、各写到哪个目录,由本原型的 tspconfig.yaml 决定。
contracts-schema:
	$(PNPM) exec tsp compile $(CONTRACTS_SRC)

# 从 JSON Schema 生成 TypeScript 裸类型:每个 schema 出一个同名 .d.ts,各自自包含
# (被引用的类型在 schema 内已内联,故不会产生跨文件的重复导出)。
contracts-ts: contracts-schema
	rm -rf $(CONTRACTS_TS_OUT)
	mkdir -p $(CONTRACTS_TS_OUT)
	@for schema in $(CONTRACTS_TMP)/schema/*.yaml; do \
	  [ -e "$$schema" ] || { echo "  (无 schema 产物,跳过)"; continue; }; \
	  base=$$(basename "$$schema" .yaml); \
	  kebab=$$(printf '%s' "$$base" | sed -E 's/([a-z0-9])([A-Z])/\1-\2/g' | tr '[:upper:]' '[:lower:]'); \
	  echo "  $(CONTRACTS_TMP)/schema/$$base.yaml -> $(CONTRACTS_TS_OUT)/$$kebab.d.ts"; \
	  $(PNPM) exec json2ts "$$schema" --additionalProperties false -o "$(CONTRACTS_TS_OUT)/$$kebab.d.ts" || exit 1; \
	done

# 清理全部生成物。
contracts-clean:
	rm -rf $(CONTRACTS_TMP) $(CONTRACTS_TS_OUT)

# ---- 快速冒烟(开发回路内,秒级到分钟级,不阻塞交付)----
# 默认只跑仓库级通用兜底(tests/smoke:console error / 请求失败 / 多宽度横向溢出);
# 本原型在 tests/calibrate 里写的断言按改动范围挑,用 SPECS 显式指定,例如:
#   make smoke SPECS="tests/calibrate/account.spec.ts"
# 不指定 SPECS 时**不会**再跑全部 calibrate —— 全量属于 `make smoke-full`
# 与 `protodesign-verify` skill 的职责,不进每次改动的反馈回路。
# 像素比对由 SMOKE=1 跳过(基线按 OS 生成,跨 OS 必然假失败)。
# DEV_COMMAND 把当前可用的包管理器命令注入给 playwright 的 webServer(见 playwright.config.ts)。
DEV_COMMAND ?= $(PNPM) dev --host 127.0.0.1 --port $(PORT)

# ---- 快检选测与预算 ----
# SPECS / GREP / LAST_FAILED 用于把日常快检收窄到本次改动:
#   make quick-check SPECS="tests/quick/agent-settings.spec.ts" GREP="@area:agent-settings"
#   make quick-check LAST_FAILED=1
# 不传时跑 tests/quick 全部;AUTO=1 时按 tests/impact-map.json 从 git diff 自动选 area。
SPECS ?=
GREP ?=
LAST_FAILED ?=
AUTO ?= 0
MAX_FAILURES ?= 5
QUICK_TIMEOUT ?= 90
QUICK_DIR ?= tests/quick
export SPECS GREP LAST_FAILED AUTO MAX_FAILURES QUICK_TIMEOUT QUICK_DIR

smoke: contracts
	@if [ -n "$(SPECS)" ]; then \
	  echo "smoke: tests/smoke + $(SPECS) $(if $(GREP),grep=$(GREP),)"; \
	  DEV_COMMAND="$(DEV_COMMAND)" SMOKE=1 $(PNPM) exec playwright test $(SMOKE_PROJECTS) $(PLAYWRIGHT_GREP) $(PLAYWRIGHT_MAX_FAILURES) $(PLAYWRIGHT_LAST_FAILED) $(SPECS); \
	else \
	  echo "smoke: tests/smoke(未指定 SPECS,跳过本原型断言)"; \
	  DEV_COMMAND="$(DEV_COMMAND)" SMOKE=1 $(PNPM) exec playwright test --project=smoke $(PLAYWRIGHT_GREP) $(PLAYWRIGHT_MAX_FAILURES); \
	fi

# ---- 日常快检(开发回路唯一入口)----
# 硬预算 90 秒:先跑通用冒烟(秒级),再跑 tests/quick 或 SPECS 指定的断言。
# AUTO=1 时由 ../quick-check.mjs 读 tests/impact-map.json,按 git diff 自动选 area。
# 超时/超预算直接失败,不做后台轮询 —— 需要更长时间说明选测太宽,应缩小 GREP。
quick-check: contracts
	DEV_COMMAND="$(DEV_COMMAND)" SMOKE=1 node ../quick-check.mjs

# 组件级测试(Vitest + Vue Test Utils):纯逻辑 / 状态 / 事件,不启浏览器。
quick-component: contracts
	@if node -e "const p=require('./package.json');process.exit(p.scripts&&p.scripts['test:component']?0:1)"; then \
	  $(PNPM) run test:component; \
	else \
	  echo "quick-component: 本原型未配置组件测试(无 test:component 脚本)"; \
	fi

# 一条命令跑完日常快检的两层。
quick-all: quick-component quick-check

# Storybook:组件预览与视觉基线。
storybook:
	@if node -e "const p=require('./package.json');process.exit(p.scripts&&p.scripts.storybook?0:1)"; then \
	  $(PNPM) run storybook; \
	else \
	  echo "storybook: 本原型未配置 Storybook"; \
	fi

storybook-test:
	@if node -e "const p=require('./package.json');process.exit(p.scripts&&p.scripts['test:storybook']?0:1)"; then \
	  $(PNPM) run test:storybook; \
	else \
	  echo "storybook-test: 本原型未配置 Storybook 视觉测试"; \
	fi

storybook-build:
	@if node -e "const p=require('./package.json');process.exit(p.scripts&&p.scripts['build-storybook']?0:1)"; then \
	  $(PNPM) run build-storybook; \
	else \
	  echo "storybook-build: 本原型未配置 Storybook"; \
	fi

# ---- 全量冒烟(手动触发,归 protodesign-verify)----
# 跑全部 calibrate 断言 + 通用冒烟,仍是单引擎且不看像素。
smoke-full: contracts
	DEV_COMMAND="$(DEV_COMMAND)" SMOKE=1 $(PNPM) exec playwright test --project=smoke --project=chromium

# ---- 设计校准(双引擎)----
# 同一原型在 Chromium 与 WebKit 上各跑一遍:逐宽度截图 + 断言不破版。
# 两个引擎都要跑,是因为桌面壳在 macOS / Linux 用 WebKit 系、在 Windows 用 Chromium 系;
# 只在 Chrome 里验过的布局,到了壳里可能不成立。
# 需要原型自带 playwright.config.ts 与 tests/calibrate/。
# 显式指定两个引擎 project:config 里还有 smoke project,不指定会被一并跑进来。
calibrate:
	DEV_COMMAND="$(DEV_COMMAND)" $(PNPM) exec playwright test --project=chromium --project=webkit

# 基线更新:确认布局变化是预期的之后,重新生成截图基线(改动的图需在评审里过目)。
calibrate-update:
	DEV_COMMAND="$(DEV_COMMAND)" $(PNPM) exec playwright test --update-snapshots --project=chromium --project=webkit
